<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sanctuary.Starting" parent="Theme.Sanctuary">
        <item name="postSplashScreenTheme">@style/Theme.Sanctuary</item>
    </style>

    <style name="Theme.Sanctuary.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sanctuary_primary</item>
        <item name="colorOnPrimary">@color/sanctuary_on_accent</item>
        <item name="colorSecondary">@color/sanctuary_primary</item>
        <item name="colorSurface">@color/sanctuary_surface_card</item>
        <item name="colorOnSurface">@color/sanctuary_text</item>
        <item name="android:colorAccent">@color/sanctuary_primary</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Sanctuary.Picker</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Sanctuary.Picker</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/sanctuary_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/sanctuary_surface</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Sanctuary" parent="Theme.Sanctuary.Base" />
    <style name="Theme.Sanctuary.Picker" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/sanctuary_primary</item>
        <item name="android:colorBackground">@color/sanctuary_surface_card</item>
        <item name="android:windowBackground">@drawable/sanctuary_dialog_background</item>
        <item name="android:datePickerStyle">@style/Widget.Sanctuary.DatePicker</item>
        <item name="android:timePickerStyle">@style/Widget.Sanctuary.TimePicker</item>
        <item name="android:textColorPrimary">@color/sanctuary_text</item>
        <item name="android:textColorSecondary">@color/sanctuary_text_muted</item>
    </style>
    <style name="Widget.Sanctuary.DatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/sanctuary_surface_raised</item>
    </style>
    <style name="Widget.Sanctuary.TimePicker" parent="android:style/Widget.Material.TimePicker">
        <item name="android:headerBackground">@color/sanctuary_surface_raised</item>
    </style>
</resources>
