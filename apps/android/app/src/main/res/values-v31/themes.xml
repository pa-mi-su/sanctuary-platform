<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sanctuary" parent="Theme.Sanctuary.Base">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/sanctuary_hero</item>
    </style>

    <style name="Theme.Sanctuary.Starting" parent="Theme.Sanctuary">
        <item name="android:windowSplashScreenBackground">@color/sanctuary_hero</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/brand_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/sanctuary_hero</item>
        <item name="postSplashScreenTheme">@style/Theme.Sanctuary</item>
    </style>
</resources>
